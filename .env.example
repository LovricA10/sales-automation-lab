# Copy to .env or set as environment variables. Never commit .env.
SALES_LAB_INPUT=data/sales.csv
SALES_LAB_DB=sales.db
SALES_LAB_OUTPUT=outputs

# Backend API. Generate a secret with e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SALES_API_DATABASE_URL=postgresql+psycopg://sales:sales@localhost:5432/sales
SALES_API_JWT_SECRET=change-me-to-a-long-random-string
